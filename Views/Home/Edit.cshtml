@model Contact
@{
    ViewData["Title"] = "Edit Contact";
    var IsNew = (bool)(ViewBag.IsNew ?? false);

    var htmlAttributes = new
    {
        @@class = "form-control"
    };
    var editorAttributes = new
    {
        htmlAttributes
    };
    var validationAttributes = new
    {
        @@class = "text-danger"
    };
}

@if (IsNew)
{
    <h1>New Contact</h1>
}
else
{
    <h1>Edit @Model.Name</h1>
}
<div class="row">
    <div class="col-md-4">
        @using (Html.BeginForm())
        {
            @Html.HiddenFor(model => model.Id)

            <div class="form-group">
                @Html.LabelFor(model => model.FirstName)
                @Html.EditorFor(model => model.FirstName, editorAttributes)
                @Html.ValidationMessageFor(model => model.FirstName, null, validationAttributes)
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.LastName)
                @Html.EditorFor(model => model.LastName, editorAttributes)
                @Html.ValidationMessageFor(model => model.LastName, null, validationAttributes)
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.PhoneNumber)
                @Html.EditorFor(model => model.PhoneNumber, editorAttributes)
                @Html.ValidationMessageFor(model => model.PhoneNumber, null, validationAttributes)
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Email)
                @Html.EditorFor(model => model.Email, editorAttributes)
                @Html.ValidationMessageFor(model => model.Email, null, validationAttributes)
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Address)
                @Html.EditorFor(model => model.Address, editorAttributes)
                @Html.ValidationMessageFor(model => model.Address, null, validationAttributes)
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Type)
                @Html.DropDownListFor(model => model.Type, Html.GetEnumSelectList<ContactType>(), "Contact Type",
            htmlAttributes)
                @Html.ValidationMessageFor(model => model.Type, null, validationAttributes)
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Birthday)
                @Html.EditorFor(model => model.Birthday, editorAttributes)
                @Html.ValidationMessageFor(model => model.Birthday, null, validationAttributes)
            </div>
            

            <br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        }
    </div>
</div>
<br />
@Html.ActionLink("< Back", "Index", new { }, new { @class = "btn btn-info" })