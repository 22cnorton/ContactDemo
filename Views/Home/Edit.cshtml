@model Contact
@{
    ViewData["Title"] = "Edit Contact";
    var IsNew = (bool)(ViewBag.IsNew ?? false);

    var htmlAttributes = new
    {
        @@class = "form-control"
    };
    var editorAttributes = new
    {
        htmlAttributes
    };
    var validationAttributes = new
    {
        @@class = "text-danger"
    };
}

@if (IsNew)
{
    <h1>New Contact</h1>
}
else
{
    <h1>Edit "@Model.Name"</h1>
}
<div class="row">
    <div class="col-md-4">
        @using (Html.BeginForm())
        {
            @Html.HiddenFor(model => model.Id)

            @Html.EditorForModel()
            

            <br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        }
    </div>
</div>
<br />
@Html.ActionLink("< Back", "Index", new { }, new { @class = "btn btn-info" })