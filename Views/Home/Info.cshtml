@model Contact
@{
    ViewData["Title"] = "Edit Contact";
    var IsNew = (bool)(ViewBag.IsNew ?? false);

    var htmlAttributes = new
    {
        @@class = "form-control"
    };
    var editorAttributes = new
    {
        htmlAttributes
    };
    var validationAttributes = new
    {
        @@class = "text-danger"
    };
}

<h1>@Model.Name</h1>

<div class="row">
    <div class="col-md-4">
        <dl>
            <dt>@Html.LabelFor(model => model.PhoneNumber)</dt>
            <dd>@Html.DisplayFor(model => model.PhoneNumber)</dd>

            <dt>@Html.LabelFor(model => model.Email)</dt>
            <dd>@Html.DisplayFor(model => model.Email)</dd>

            <dt>@Html.LabelFor(model => model.Address)</dt>
            <dd>@Html.DisplayFor(model => model.Address)</dd>

            <dt>@Html.LabelFor(model => model.Type)</dt>
            <dd>@Html.DisplayFor(model => model.Type)</dd>
        </dl>
    </div>
</div>

@Html.ActionLink("< Back", "Index", new { }, new { @class = "btn btn-info" })