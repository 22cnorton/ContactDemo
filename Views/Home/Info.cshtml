@model Contact
@{
    ViewData["Title"] = Model.Name;
    var IsNew = (bool)(ViewBag.IsNew ?? false);

    var htmlAttributes = new
    {
        @@class = "form-control"
    };
    var editorAttributes = new
    {
        htmlAttributes
    };
    var validationAttributes = new
    {
        @@class = "text-danger"
    };
}

<h1>@Model.Name</h1>

<div class="row">
    <div class="col-md-4">
        @await Html.PartialAsync("./_Details.cshtml", Model)
    </div>
</div>

@Html.ActionLink("< Back", "Index", new { }, new { @class = "btn btn-info" })