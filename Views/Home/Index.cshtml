@model IEnumerable<Contact>
@{
    ViewData["Title"] = "Home Page";
}

<h1>Contacts</h1>

@if (Model is not null)
{
    <dl>
        @foreach (var contact in Model)
        {
            <dt>@contact.Name</dt>
            <dd>
                @using (Html.BeginForm("Delete", "Home", new { id = contact.Id }, FormMethod.Post, null, new
                {
                    onsubmit = "return confirm('Are you sure you want to delete this?');"
                }))
                {
                    @Html.AntiForgeryToken()
                    <div class="btn-group">
                        @Html.ActionLink("Info", "Info", new { contact.Id }, new { @class = "btn btn-info" })
                        @Html.ActionLink("Edit", "Edit", new { contact.Id }, new { @class = "btn btn-success" })
                        <button type="submit" class="btn btn-danger">Delete</button>
                        @if (contact.HasInfo)
                        {
                            <button type="button" data-bs-toggle="collapse" data-bs-target="#quickEdit_@contact.Id"
                                    class='btn btn-secondary'>Quick View</button>
                        }
                    </div>
                }
            </dd>
            <dd class="collapse col-md-6" id="quickEdit_@contact.Id">
                @await Html.PartialAsync("_Details", contact)
            </dd>
        }
    </dl>
}

@Html.ActionLink("Add New", "Edit", new { }, new { @class = "btn btn-primary" })

